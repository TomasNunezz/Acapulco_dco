@model Acapulco.Models.Compra

@{
    ViewData["Title"] = "Compra confirmada";
}

<h1>¡Gracias por tu compra!</h1>
<p>Compra N° @Model.Id, realizada el @Model.Fecha.ToString("dd/MM/yyyy HH:mm").</p>

<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model.Items)
        {
            <tr>
                <td>@i.Producto.Nombre</td>
                <td>@i.Cantidad</td>
                <td>@i.PrecioUnitario.ToString("C0")</td>
                <td>@((i.Cantidad * i.PrecioUnitario).ToString("C0"))</td>
            </tr>
        }
    </tbody>
</table>

<h4>Total: @Model.Total.ToString("C0")</h4>

<a asp-controller="Productos" asp-action="Index" class="btn btn-dark">Seguir comprando</a>